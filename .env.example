# Database Connection
CONNECTIONSTRING=Host=localhost;Database=weights;Username=postgres;Password=yourpassword

# JWT Settings
JWT_SECRET_KEY=your-super-secret-key-minimum-32-characters-long
JWT_ISSUER=WeightsAPI
JWT_AUDIENCE=WeightsClient
JWT_EXPIRATION_MINUTES=60

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
ASPNETCORE_HTTPS_PORTS=8081
